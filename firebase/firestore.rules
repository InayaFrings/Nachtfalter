rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.email is string
      && request.auth.token.email.lower() == 'inayafrings@gmail.com'; }
    // Offene Anmeldung (Inaya, 2026-10-10): jedes angemeldete Konto ist Mitglied, ein Einladungslink ist nicht mehr nötig
    function invited() { return signedIn(); }
    function me(uid) { return invited() && request.auth.uid == uid; }

    // Eigene Daten: nur die Person selbst
    match /data/users/{uid}/{rest=**} { allow read, write: if me(uid); }

    // Profile, Namen, Freundeslisten: alle Mitglieder lesen, nur man selbst schreibt.
    // Dazu gehören die öffentlichen Geräteschlüssel für verschlüsselte Chats (profiles/<uid>/e2ee/<gerät>):
    // nur die Person selbst kann Schlüssel für sich anlegen oder entfernen (Inaya, 2026-10-13)
    match /profiles/{uid} { allow read: if invited(); allow write: if me(uid); }
    match /profiles/{uid}/{rest=**} { allow read: if invited(); allow write: if me(uid); }
    match /handles/{uid} { allow read: if invited(); allow write: if me(uid); }
    match /friends/{uid} { allow read: if invited(); allow write: if me(uid); }

    // Einladungslinks: jeder Link gilt nur einmal
    match /invites/{t} {
      allow get: if true;
      allow create: if invited() && t.size() >= 16 && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by', 'ts']);
      allow update: if signedIn() && !('usedBy' in resource.data)
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedTs']);
    }
    match /members/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inv)).data.usedBy == uid;
    }

    // Anmelden mit Nutzername: einzeln abrufbar (nicht auflistbar); schreiben nur für den eigenen Nutzernamen
    match /logins/{h} {
      allow get: if true;
      allow create, update: if invited() && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && get(/databases/$(database)/documents/handles/$(request.auth.uid)).data.h == h
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Gästebuch (wall_<uid>): schreiben nur gegenseitige Freunde und die Person selbst (Inaya, 2026-10-10)
    function friendsWith(uid) { return request.auth.uid == uid
      || (request.auth.uid in get(/databases/$(database)/documents/friends/$(uid)).data.list
        && uid in get(/databases/$(database)/documents/friends/$(request.auth.uid)).data.list); }

    // Private Chats (dm_<a>_<b>) und Gruppen (g…): nur Mitglieder (Inaya, 2026-10-13).
    // Vorher konnte jedes angemeldete Konto alle Chats lesen und Mitgliederlisten ändern.
    function isDm(cid) { return cid.matches('dm_[A-Za-z0-9]+_[A-Za-z0-9]+'); }
    function isGroup(cid) { return cid.matches('g[0-9a-z]+'); }
    function inDm(cid) { return request.auth.uid in cid.split('_'); }
    function chatDoc(cid) { return get(/databases/$(database)/documents/chats/$(cid)).data; }
    function inGroup(cid) { return request.auth.uid in chatDoc(cid).members; }
    function groupOpen(cid) { return chatDoc(cid).pub == true; }
    function mayRead(cid) { return isDm(cid) ? inDm(cid) : isGroup(cid) ? (inGroup(cid) || groupOpen(cid)) : true; }
    function mayWrite(cid) { return isDm(cid) ? inDm(cid) : isGroup(cid) ? inGroup(cid) : true; }

    match /chats/{cid}/m/{mid} {
      allow read: if invited() && mayRead(cid);
      allow create: if invited() && (cid.matches('wall_.+')
        ? (request.resource.data.from == request.auth.uid && friendsWith(cid.split('_')[1]))
        : (isDm(cid) || isGroup(cid)) ? (mayWrite(cid) && request.resource.data.from == request.auth.uid) : true);
      // Verschlüsselte Nachrichten: der Absender darf ändern, andere Mitglieder nur den übertragenen Verlauf (Feld x) ergänzen
      allow update: if invited() && !cid.matches('wall_.+') && ((isDm(cid) || isGroup(cid))
        ? (mayWrite(cid) && (resource.data.from == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x'])))
        : true);
      allow delete: if invited() && (cid.matches('wall_.+')
        ? (request.auth.uid == cid.split('_')[1] || resource.data.from == request.auth.uid)
        : (isDm(cid) || isGroup(cid)) ? mayWrite(cid) : true);
    }

    // Chat-Dokumente: Liste nur über die eigene Mitgliedschaft oder öffentliche Gruppen
    match /chats/{cid} {
      allow get: if invited() && (isDm(cid) ? inDm(cid) : isGroup(cid) ? (request.auth.uid in resource.data.members || resource.data.pub == true) : true);
      allow list: if invited() && (request.auth.uid in resource.data.members || resource.data.pub == true);
      allow create: if invited() && (isDm(cid)
        ? (inDm(cid) && request.resource.data.members.hasOnly(cid.split('_')))
        : isGroup(cid) ? request.auth.uid in request.resource.data.members : true);
      // Gruppe: Mitglieder dürfen ändern; einer öffentlichen Gruppe darf man selbst beitreten
      allow update: if invited() && (isDm(cid) ? inDm(cid)
        : isGroup(cid) ? (request.auth.uid in resource.data.members
          || (resource.data.pub == true && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])))
        : true);
      allow delete: if invited() && (isDm(cid) ? inDm(cid) : isGroup(cid) ? request.auth.uid in resource.data.members : true);
    }
    match /chats/{cid}/{sub}/{rest=**} { allow read, write: if invited() && sub != 'm' && mayWrite(cid); }

    // Wer gerade online ist
    match /presence/{room}/p/{key} {
      allow read: if invited();
      allow create, update: if invited() && request.resource.data.by == request.auth.uid;
      allow delete: if signedIn();
    }

    // Seiten-Einstellungen: nur Inaya
    match /site/{rest=**} { allow read: if invited(); allow write: if isOwner(); }
  }
}
