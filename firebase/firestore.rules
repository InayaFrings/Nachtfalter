rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.email is string
      && request.auth.token.email.lower() == 'inayafrings@gmail.com'; }
    // Offene Anmeldung (Inaya, 2026-10-10): jedes angemeldete Konto ist Mitglied, ein Einladungslink ist nicht mehr nötig
    function invited() { return signedIn(); }
    function me(uid) { return invited() && request.auth.uid == uid; }

    // Eigene Daten: nur die Person selbst
    match /data/users/{uid}/{rest=**} { allow read, write: if me(uid); }

    // Profile, Namen, Freundeslisten: alle Mitglieder lesen, nur man selbst schreibt.
    // Dazu gehören die öffentlichen Geräteschlüssel für verschlüsselte Chats (profiles/<uid>/e2ee/<gerät>):
    // nur die Person selbst kann Schlüssel für sich anlegen oder entfernen (Inaya, 2026-10-13)
    // Profilbild und Titelbild nur als echtes Rasterbild (JPEG, PNG, WebP, GIF als data:-URL), nie SVG oder Text mit Code (Inaya, 2026-10-15)
    function picOk(d, k) { return !(k in d) || d[k] == null || (d[k] is string && d[k].size() < 600000
      && d[k].matches('data:image/(jpeg|png|webp|gif);base64,[A-Za-z0-9+/]+=*')); }
    match /profiles/{uid} { allow read: if invited();
      allow create, update: if me(uid) && picOk(request.resource.data, 'pic') && picOk(request.resource.data, 'cover');
      allow delete: if me(uid); }
    // nur Unterordner (z. B. e2ee); {rest=**} allein würde auch das Profil selbst treffen und die Bildprüfung aushebeln
    match /profiles/{uid}/{sub}/{rest=**} { allow read: if invited(); allow write: if me(uid); }
    match /handles/{uid} { allow read: if invited(); allow write: if me(uid); }
    match /friends/{uid} { allow read: if invited(); allow write: if me(uid); }

    // Einladungslinks: jeder Link gilt nur einmal
    match /invites/{t} {
      allow get: if true;
      allow create: if invited() && t.size() >= 16 && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by', 'ts']);
      allow update: if signedIn() && !('usedBy' in resource.data)
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedTs']);
    }
    match /members/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inv)).data.usedBy == uid;
    }

    // Anmelden mit Nutzername: einzeln abrufbar (nicht auflistbar); schreiben nur für den eigenen Nutzernamen.
    // Seit 2026-10-15 steht die E-Mail nur noch verschlüsselt drin (v:2, Schlüssel aus dem Passwort). Alte Einträge mit offener
    // E-Mail sind nicht mehr abrufbar, damit niemand fremde E-Mail-Adressen sammeln kann.
    match /logins/{h} {
      allow get: if resource == null || resource.data.get('v', 0) == 2;
      allow create, update: if invited() && request.resource.data.uid == request.auth.uid
        && request.resource.data.v == 2 && request.resource.data.keys().hasOnly(['uid', 'v', 's', 'iv', 'c', 'ts'])
        && request.resource.data.c is string && request.resource.data.c.size() < 600
        && get(/databases/$(database)/documents/handles/$(request.auth.uid)).data.h == h
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Gästebuch (wall_<uid>): schreiben nur gegenseitige Freunde und die Person selbst (Inaya, 2026-10-10)
    function friendsWith(uid) { return request.auth.uid == uid
      || (request.auth.uid in get(/databases/$(database)/documents/friends/$(uid)).data.list
        && uid in get(/databases/$(database)/documents/friends/$(request.auth.uid)).data.list); }

    // Private Chats (dm_<a>_<b>) und Gruppen (g…): nur Mitglieder (Inaya, 2026-10-13).
    // Vorher konnte jedes angemeldete Konto alle Chats lesen und Mitgliederlisten ändern.
    function isDm(cid) { return cid.matches('dm_[A-Za-z0-9]+_[A-Za-z0-9]+'); }
    function isGroup(cid) { return cid.matches('g[0-9a-z]+'); }
    function inDm(cid) { return request.auth.uid in cid.split('_'); }
    function chatDoc(cid) { return get(/databases/$(database)/documents/chats/$(cid)).data; }
    function inGroup(cid) { return request.auth.uid in chatDoc(cid).members; }
    function groupOpen(cid) { return chatDoc(cid).pub == true; }
    function mayRead(cid) { return isDm(cid) ? inDm(cid) : isGroup(cid) ? (inGroup(cid) || groupOpen(cid)) : true; }
    function mayWrite(cid) { return isDm(cid) ? inDm(cid) : isGroup(cid) ? inGroup(cid) : true; }

    match /chats/{cid}/m/{mid} {
      allow read: if invited() && mayRead(cid);
      allow create: if invited() && (cid.matches('wall_.+')
        ? (request.resource.data.from == request.auth.uid && friendsWith(cid.split('_')[1]))
        : (isDm(cid) || isGroup(cid)) ? (mayWrite(cid) && request.resource.data.from == request.auth.uid) : true);
      // Verschlüsselte Nachrichten: der Absender darf ändern, andere Mitglieder nur den übertragenen Verlauf (Feld x) ergänzen
      allow update: if invited() && !cid.matches('wall_.+') && ((isDm(cid) || isGroup(cid))
        ? (mayWrite(cid) && (resource.data.from == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x'])))
        : true);
      allow delete: if invited() && (cid.matches('wall_.+')
        ? (request.auth.uid == cid.split('_')[1] || resource.data.from == request.auth.uid)
        : (isDm(cid) || isGroup(cid)) ? mayWrite(cid) : true);
    }

    // Chat-Dokumente: Liste nur über die eigene Mitgliedschaft oder öffentliche Gruppen
    match /chats/{cid} {
      allow get: if invited() && (isDm(cid) ? inDm(cid) : isGroup(cid) ? (request.auth.uid in resource.data.members || resource.data.pub == true) : true);
      allow list: if invited() && (request.auth.uid in resource.data.members || resource.data.pub == true);
      allow create: if invited() && (isDm(cid)
        ? (inDm(cid) && request.resource.data.members.hasOnly(cid.split('_')))
        : isGroup(cid) ? request.auth.uid in request.resource.data.members : true);
      // Gruppe: Mitglieder dürfen ändern; einer öffentlichen Gruppe darf man selbst beitreten, einer privaten nur mit Einladung (chats/<gruppe>/inv/<uid>, Inaya 2026-10-14)
      allow update: if invited() && (isDm(cid) ? inDm(cid)
        : isGroup(cid) ? (request.auth.uid in resource.data.members
          || ((resource.data.pub == true || exists(/databases/$(database)/documents/chats/$(cid)/inv/$(request.auth.uid)))
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])))
        : true);
      allow delete: if invited() && (isDm(cid) ? inDm(cid) : isGroup(cid) ? request.auth.uid in resource.data.members : true);
    }
    match /chats/{cid}/{sub}/{rest=**} { allow read, write: if invited() && sub != 'm' && sub != 'rd' && sub != 'talk' && mayWrite(cid); }

    // Anrufe und Talks (Inaya, 2026-10-13): chats/<cid>/talk/<id> mit Plätzen p:{<uid>:{t, s}}.
    // Höchstens 2 Plätze im privaten Chat, sonst 9 je Talk. Jeder ändert nur den eigenen Platz; verwaiste Plätze (45 s ohne Herzschlag) darf jedes Mitglied freigeben.
    // Eigene Talks in öffentlichen Gruppen darf jedes Mitglied erstellen (Feld by), umbenennen und löschen nur der Admin der Gruppe oder wer ihn erstellt hat.
    function talkMax(cid) { return isDm(cid) ? 2 : 9; }
    function groupAdmin(cid) { return isGroup(cid) && chatDoc(cid).createdBy == request.auth.uid; }
    function pubGroup(cid) { return isGroup(cid) && chatDoc(cid).pub == true; }
    match /chats/{cid}/talk/{tid} {
      allow read: if invited() && mayRead(cid);
      allow create: if invited() && mayWrite(cid) && request.resource.data.p.size() == 0
        && request.resource.data.keys().hasOnly(['name', 'kind', 'def', 'ts', 'p', 'by'])
        && request.resource.data.kind in ['audio', 'video'] && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && ((tid == 'audio' || tid == 'video') ? request.resource.data.kind == tid
          : (pubGroup(cid) && request.resource.data.by == request.auth.uid && request.resource.data.def == 0 && request.resource.data.name.size() > 0));
      allow update: if invited() && mayWrite(cid) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['p'])
          && request.resource.data.p.diff(resource.data.p).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.p.size() <= talkMax(cid))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['p', 'gone'])
          && request.resource.data.p.diff(resource.data.p).affectedKeys().hasOnly([request.resource.data.gone])
          && !(request.resource.data.gone in request.resource.data.p)
          && (resource.data.p[request.resource.data.gone].t < request.time.toMillis() - 45000
            || resource.data.p[request.resource.data.gone].t > request.time.toMillis() + 120000)) // auch Geisterplätze mit vorgehender Uhr
        || ((groupAdmin(cid) || resource.data.get('by', '') == request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40));
      allow delete: if invited() && mayWrite(cid) && (groupAdmin(cid) || resource.data.get('by', '') == request.auth.uid) && tid != 'audio' && tid != 'video';
      // Verbindungsaufbau: nur an die Person selbst lesbar
      match /sig/{mid} {
        allow create: if invited() && mayWrite(cid) && request.resource.data.from == request.auth.uid;
        allow read: if invited() && resource.data.to == request.auth.uid;
        allow delete: if invited() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      }
      // Mikrofon und Kamera an/aus
      match /st/{uid} { allow read: if invited() && mayRead(cid); allow write: if me(uid) && mayWrite(cid); }
    }

    // Klingeln: nur Mitglieder desselben privaten Chats bzw. derselben privaten Gruppe
    match /rings/{uid}/r/{rid} {
      allow read, delete: if signedIn() && (request.auth.uid == uid || resource.data.from == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.from == request.auth.uid
        && (isDm(request.resource.data.cid) || isGroup(request.resource.data.cid))
        && uid in chatDoc(request.resource.data.cid).members && request.auth.uid in chatDoc(request.resource.data.cid).members;
    }
    // Lesebestätigungen: jede Person schreibt nur ihren eigenen Lesestand (Inaya, 2026-10-13)
    match /chats/{cid}/rd/{uid} { allow read: if invited() && mayRead(cid); allow write: if me(uid) && mayWrite(cid); }

    // Wer gerade online ist
    match /presence/{room}/p/{key} {
      allow read: if invited();
      allow create, update: if invited() && request.resource.data.by == request.auth.uid;
      allow delete: if signedIn();
    }

    // Seiten-Einstellungen: nur Inaya
    match /site/{rest=**} { allow read: if invited(); allow write: if isOwner(); }

    /* ---------- Nocti-Coins, XP, Level, Inventar und Geschenke (Inaya, 2026-10-16) ----------
       wallet/<uid> = {c: Coins, x: XP, l: Level, inv: {<item>: true}, dd: Tag der letzten Tagesbelohnung,
                       xd: {d: Tag, n: {<art>: Anzahl heute}, r: {<beleg>: true}}, fx: {<freund>: true}, gx: {<j|k><gruppe>: true}, op: {t, …}}
       Jede Änderung beschreibt in op, was passiert ist; die Regeln rechnen nach. Nichts davon lässt sich im Browser ausdenken:
       Preise stehen hier, Tageslimits und Belege verhindern Farmen, XP gibt es nur mit Nachweis (Like, Kommentar, Freundschaft, Gruppe …).
       Tag = Kalendertag in deutscher Winterzeit (UTC+1). Level L ab 25·L·(L-1) XP. Coins für Level: 30 je Level, +100 alle 5 Level. */
    function W() { return resource.data; }
    function N() { return request.resource.data; }
    function today() { return math.floor((request.time.toMillis() + 3600000) / 86400000); }
    function lvT(l) { return 25 * l * (l - 1); }
    function lvOk(l, x) { return l is int && l >= 1 && lvT(l) <= x && x < lvT(l + 1); }
    function lvC(l) { return 30 * (l - 1) + 100 * math.floor(l / 5); }
    function gain(xp, coins) { return N().x == W().x + xp && lvOk(N().l, N().x) && N().c == W().c + coins + lvC(N().l) - lvC(W().l); }
    function xv(k) { return {'f': 25, 'p': 15, 'l': 3, 'c': 5, 'g': 5, 'j': 15, 'k': 30, 'm': 2}[k]; }
    function xcap(k) { return {'f': 5, 'p': 3, 'l': 10, 'c': 8, 'g': 6, 'j': 3, 'k': 1, 'm': 10}[k]; }
    function xdOld() { return W().xd.d == today() ? W().xd : {'d': today(), 'n': {}, 'r': {}}; }
    function xdOk(k, rk) { let o = xdOld();
      return N().xd.keys().hasOnly(['d', 'n', 'r']) && N().xd.d == today()
        && o.n.get(k, 0) < xcap(k) && N().xd.n.get(k, 0) == o.n.get(k, 0) + 1 && N().xd.n.diff(o.n).affectedKeys().hasOnly([k])
        && (rk == '' ? N().xd.r == o.r : (!(rk in o.r) && N().xd.r.diff(o.r).affectedKeys().hasOnly([rk]) && N().xd.r[rk] == true)); }
    function piDoc(ref, d) { return get(/databases/$(database)/documents/chats/$('pi_' + ref)/m/$(d)).data; }
    function xpProof(op) { let k = op.k; let ref = op.ref; let u = request.auth.uid;
      return k == 'g' ? true
        : k == 'f' ? ref != u && friendsWith(ref)
        : k == 'p' ? get(/databases/$(database)/documents/profiles/$(u)).data.lastPost.id == ref
        : k == 'l' ? ref.split('_')[0] != u && piDoc(ref, u + '_klike').by == u
        : k == 'c' ? ref.split('_')[0] != u && piDoc(ref, op.d).by == u && piDoc(ref, op.d).kind == 'c'
        : k == 'j' ? isGroup(ref) && chatDoc(ref).pub == true && u in chatDoc(ref).members
        : k == 'k' ? isGroup(ref) && chatDoc(ref).pub == true && chatDoc(ref).createdBy == u
        : k == 'm' ? isGroup(ref) && chatDoc(ref).pub == true && get(/databases/$(database)/documents/chats/$(ref)/m/$(op.d)).data.from == u
        : false; }
    function xpOp(op) { let k = op.k; let ref = op.ref;
      return k in ['f', 'p', 'l', 'c', 'g', 'j', 'k', 'm'] && ref is string && ref.size() > 0 && ref.size() < 160
        && N().diff(W()).affectedKeys().hasOnly(['x', 'l', 'c', 'xd', 'fx', 'gx', 'op']) && N().inv == W().inv && N().dd == W().dd
        && gain(xv(k), 0) && xpProof(op)
        && (k == 'f' ? (!(ref in W().fx) && N().fx.diff(W().fx).affectedKeys().hasOnly([ref]) && N().gx == W().gx && xdOk(k, ''))
          : (k == 'j' || k == 'k') ? (!((k + ref) in W().gx) && N().gx.diff(W().gx).affectedKeys().hasOnly([k + ref]) && N().fx == W().fx && xdOk(k, ''))
          : (N().fx == W().fx && N().gx == W().gx && xdOk(k, k + ':' + ((k == 'c' || k == 'p' || k == 'l') ? ref : (k == 'm' ? op.d : ref))))); }
    // Preise im Shop (Coins). Muss zu NC in index.html passen (Test t_prices).
    function price(i) { return {
      'nc_fkrone': 140, 'nc_hexenhut': 120, 'nc_dornhalo': 110, 'nc_widder': 100, 'nc_neonohr': 80, 'nc_rosenkr': 100,
      'nc_mondhaar': 180, 'nc_twintails': 160, 'nc_webpulli': 130, 'nc_samtcape': 170, 'nc_flammen': 120, 'nc_schwarm': 150,
      'nc_orgel': 260, 'nc_aquarium': 200, 'nc_kamin': 190, 'nc_mondbett': 240, 'nc_knochenthron': 220, 'nc_hexkessel': 160, 'nc_neonbat': 120, 'nc_zauberspiegel': 150
    }.get(i, 0); }
    function hasItem(uid, i) { return exists(/databases/$(database)/documents/wallet/$(uid)) && i in get(/databases/$(database)/documents/wallet/$(uid)).data.inv; }
    function giftDoc(g) { return /databases/$(database)/documents/gifts/$(g); }
    match /wallet/{uid} {
      allow read: if signedIn();
      allow create: if me(uid) && N() == {'c': 150, 'x': 0, 'l': 1, 'inv': {}, 'dd': 0, 'xd': {'d': 0, 'n': {}, 'r': {}}, 'fx': {}, 'gx': {}, 'op': {'t': 'new'}};
      allow update: if me(uid) && N().op is map && (
        // Tagesbelohnung: einmal je Tag 25 Coins und 20 XP
        (N().op.t == 'daily' && W().dd < today() && N().dd == today() && gain(20, 25)
          && N().diff(W()).affectedKeys().hasOnly(['c', 'x', 'l', 'dd', 'op']))
        // XP für eine echte Aktivität
        || (N().op.t == 'xp' && xpOp(N().op))
        // Kaufen: Preis aus dieser Datei, Gegenstand neu im Inventar
        || (N().op.t == 'buy' && price(N().op.i) > 0 && !(N().op.i in W().inv) && N().c == W().c - price(N().op.i) && N().c >= 0
          && N().inv.diff(W().inv).affectedKeys().hasOnly([N().op.i]) && N().inv[N().op.i] == true
          && N().diff(W()).affectedKeys().hasOnly(['c', 'inv', 'op']))
        // Verschenken: Coins gehen ab, im selben Schritt entsteht gifts/<ich>_<freund>_<item>
        || (N().op.t == 'gift' && price(N().op.i) > 0 && N().op.g == uid + '_' + N().op.to + '_' + N().op.i
          && N().c == W().c - price(N().op.i) && N().c >= 0 && N().diff(W()).affectedKeys().hasOnly(['c', 'op'])
          && !exists(giftDoc(N().op.g)) && existsAfter(giftDoc(N().op.g)))
        // Geschenk annehmen: Gegenstand ins Inventar; hat man ihn schon, gibt es den Preis als Coins
        || (N().op.t == 'take' && get(giftDoc(N().op.g)).data.to == uid && get(giftDoc(N().op.g)).data.st == 'open'
          && getAfter(giftDoc(N().op.g)).data.st == 'taken' && N().diff(W()).affectedKeys().hasOnly(['c', 'inv', 'op'])
          && (!(get(giftDoc(N().op.g)).data.i in W().inv)
            ? (N().c == W().c && N().inv.diff(W().inv).affectedKeys().hasOnly([get(giftDoc(N().op.g)).data.i]) && N().inv[get(giftDoc(N().op.g)).data.i] == true)
            : (N().inv == W().inv && N().c == W().c + price(get(giftDoc(N().op.g)).data.i)))));
    }
    match /gifts/{g} {
      allow get: if signedIn() && (resource == null || resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow list: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn() && N().from == request.auth.uid && N().to is string && N().to != request.auth.uid
        && g == request.auth.uid + '_' + N().to + '_' + N().i && N().st == 'open' && N().keys().hasOnly(['from', 'to', 'i', 'st', 'ts'])
        && price(N().i) > 0 && friendsWith(N().to) && !hasItem(N().to, N().i)
        && getAfter(/databases/$(database)/documents/wallet/$(request.auth.uid)).data.op.t == 'gift'
        && getAfter(/databases/$(database)/documents/wallet/$(request.auth.uid)).data.op.g == g;
      allow update: if signedIn() && W().to == request.auth.uid && W().st == 'open' && N().st == 'taken'
        && N().diff(W()).affectedKeys().hasOnly(['st', 'tts'])
        && getAfter(/databases/$(database)/documents/wallet/$(request.auth.uid)).data.op.t == 'take'
        && getAfter(/databases/$(database)/documents/wallet/$(request.auth.uid)).data.op.g == g;
    }
  }
}
